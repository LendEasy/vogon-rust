  {
    "name": "public_example",
    "yaml": "# A neutral front artifact — the template for FRONT_CONFIG_PATH.\n#\n# The gateway's filler hold draws its words from a file like this one while\n# your turn service composes a reply (docs/voice-gateway-front-model.md,\n# docs/FRONT_COMPLEMENT_DESIGN.md). The gateway ships no words of its own:\n# with FRONT_CONFIG_PATH unset the model tier is off and the hold uses the\n# FillerPolicy pools your service returns in CallConfig.\n#\n# Every pool is linted at load against the same guards the model's lines get\n# (vogon/gateway/transport/front_guard.py): a line must be safe at ANY moment\n# of the call, because the rules that choose it never read what the caller\n# said. A pool with \"Okay\", \"Got it\", \"Sure\", a number or a word from\n# must_not_say refuses to load.\n#\n# This template carries only the beat pools, so a gateway pointed at it says\n# at most a four-word acknowledgement while it waits. To let the model pick a\n# fuller line, add the tiers (lookup, courtesy, repeat), move_question,\n# move_criteria, move_riders and prompt that your domain's survey supports;\n# the design doc explains how those were derived.\n\nmust_not_say: []\n\nbeats:\n  # the hold is still open at FRONT_BEAT_AFTER_MS and the model had nothing\n  hold:\n    - \"One moment.\"\n    - \"Bear with me.\"\n    - \"Just a moment.\"\n  # the answer still not back FRONT_WAIT_AGAIN_AFTER_MS after a front line\n  wait:\n    - \"Still with you.\"\n    - \"Just a moment longer.\"\n",
    "reference": {
      "ok": {
        "beats": {
          "hold": [
            "One moment.",
            "Bear with me.",
            "Just a moment."
          ],
          "wait": [
            "Still with you.",
            "Just a moment longer."
          ]
        },
        "must_not_say": []
      }
    }
  },
  {
    "name": "multiline",
    "yaml": "prompt: |\n  Help the caller.\n  Stay concise.\nmove_question: >-\n  Which move\n  fits best?\n",
    "reference": {
      "ok": {
        "move_question": "Which move fits best?",
        "prompt": "Help the caller.\nStay concise.\n"
      }
    }
  },
  {
    "name": "quotes_unicode",
    "yaml": "prompt: \"こんにちは: café # quoted\"\nbeats: {hold: [\"One moment.\"]}\n",
    "reference": {
