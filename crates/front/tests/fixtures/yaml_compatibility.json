  {
    "name": "numbers",
    "yaml": "move_criteria: {decimal: 42, leading: 012, hex: 0x10, octal: 0o12, float: 1.5, exponent: 1e3, quoted: \"42\"}\n",
    "reference": {
      "ok": {
        "move_criteria": {
          "decimal": 42,
          "exponent": 1000.0,
          "float": 1.5,
          "hex": 16,
          "leading": "012",
          "octal": 10,
          "quoted": "42"
        }
      }
    },
    "migration_note": "Unquoted leading-zero numerals now resolve as numbers; quote identifier strings to preserve their spelling.",
    "expected": {
      "ok": {
        "move_criteria": {
          "decimal": 42,
          "exponent": 1000.0,
          "float": 1.5,
          "hex": 16,
          "leading": 12.0,
          "octal": 10,
          "quoted": "42"
        }
      }
    }
  },
