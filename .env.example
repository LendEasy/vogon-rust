# Local development only. Copy to .env; never commit real credentials.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8002
GATEWAY_SESSION_STORE=memory
GATEWAY_SERVICE_KEY=local-demo-gateway
GATEWAY_PUBLIC_BASE_URL=http://127.0.0.1:8002

TURN_SERVICE_URL=http://127.0.0.1:8090/turn/v1
TURN_SERVICE_API_KEY=echo-demo
FRONT_MODEL_ENABLED=false
OPENAI_API_KEY=
AMBIENCE_ENABLED=false

# Fill locally to use live speech; text calls and the echo service need no key.
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=flux-general-en
DEEPGRAM_TTS_MODEL=aura-2-thalia-en
# EOT values intentionally inherit the implementation defaults. See KNOWN_ISSUES.md.

# Configure only for real Twilio calls; callbacks require the public gateway URL.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Exponential retry budgets (attempts includes the initial request).
GATEWAY_RETRY_ATTEMPTS=3
GATEWAY_RETRY_INITIAL_MS=200
GATEWAY_RETRY_MAX_MS=5000
GATEWAY_RETRY_JITTER=true
# Optional per-dependency overrides: TURN, FRONT, STT, TTS, TWILIO, REDIS, REPORT, S3.
# GATEWAY_RETRY_TURN_ATTEMPTS=4
# Non-replayable operations still do not retry ambiguous failures; see OPERATIONS.md.

RECORDINGS_PATH=./storage/recordings
RECORDING_ENABLED=true
S3_ENABLED=false
S3_BUCKET=
AWS_REGION=us-east-1
GATEWAY_CAPABILITY_POLICY=refuse
GATEWAY_MAX_ACTIVE_CALLS=64
GATEWAY_MAX_PENDING_HANDSHAKES=128
GATEWAY_SHUTDOWN_TIMEOUT_SEC=210
